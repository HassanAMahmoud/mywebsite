---
import { PUB_PLACEHOLDER, type Publication } from "../data/publications";
import { formatAuthorsHtml } from "../utils/formatAuthors";

interface Props {
  pub: Publication;
}

const { pub } = Astro.props;
const image = pub.image ?? PUB_PLACEHOLDER;
const authorsHtml = formatAuthorsHtml(pub.authors);
---

<article class="pub-card">
  <div class:list={["pub-thumb", pub.imageFit === "contain" && "pub-thumb--contain"]}>
    <img src={image} alt="" width="320" height="220" loading="lazy" />
  </div>
  <div class="pub-body">
    <h3 class="pub-title">{pub.title}</h3>
    <p class="pub-meta">
      <span set:html={authorsHtml} />
      <br />
      <em>{pub.venue}</em> ({pub.year})
      {
        pub.doi ? (
          <span>
            {" · "}
            <a href={pub.doi} target="_blank" rel="noopener noreferrer">
              [link]
            </a>
          </span>
        ) : null
      }
    </p>
  </div>
</article>
