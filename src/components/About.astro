---
import { profile } from "../data/profile";
---

<section class="section" id="about">
  <div class="container reveal">
    <p class="eyebrow">About</p>
    <h2 class="section-heading">Research profile</h2>
    <p class="section-lead">{profile.bio}</p>
    <div class="about-grid">
      <div class="panel">
        <h3 class="panel-title">Current focus</h3>
        <p>
          Leading printable wireless piezoelectric sensing platforms for structural health
          monitoring, nanoparticle-functionalized laser-induced graphene for flexible thermal
          applications, and sensing technologies for non-metallic pipelines under the ENERCOMP
          consortium with Saudi Aramco.
        </p>
      </div>
      <div class="panel">
        <h3 class="panel-title">Education</h3>
        <ul class="education-list">
          {profile.education.map((item) => (
            <li>
              <strong>
                {item.degree} · {item.year}
              </strong>
              <span>{item.school}</span>
              <span>{item.detail}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
