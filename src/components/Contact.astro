---
import { profile } from "../data/profile";
---

<section class="section" id="contact">
  <div class="container reveal">
    <p class="eyebrow">Contact</p>
    <h2 class="section-heading">Let’s connect</h2>
    <p class="section-lead">
      Open to research collaborations in printed wireless sensing, structural health monitoring, and
      flexible electronics.
    </p>
    <div class="contact-panel">
      <div class="panel">
        <h3 class="panel-title">Affiliation</h3>
        <p>{profile.affiliation}</p>
        <p>{profile.location}</p>
        <p>
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
        </p>
      </div>
      <div class="contact-links">
        <a href={`mailto:${profile.email}`}>Email</a>
        <a href={profile.links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href={profile.links.orcid} target="_blank" rel="noopener noreferrer">ORCID</a>
        <a href={profile.links.scholar} target="_blank" rel="noopener noreferrer">Google Scholar</a>
        <a href={profile.links.cv} download>Download CV</a>
      </div>
    </div>
  </div>
</section>
