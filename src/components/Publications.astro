---
import { journalPublications, underReview, proceedings } from "../data/publications";
import { profile } from "../data/profile";
---

<section class="section" id="publications">
  <div class="container reveal">
    <p class="eyebrow">Publications</p>
    <h2 class="section-heading">Selected papers</h2>
    <p class="section-lead">
      Journal articles, manuscripts under review, and conference proceedings from printed sensing,
      composites, and structural health monitoring research.
    </p>
    <div class="section-actions" style="margin-top: 0; margin-bottom: 1.75rem;">
      <a class="btn btn-ghost" href={profile.links.scholar} target="_blank" rel="noopener noreferrer">
        View on Google Scholar
      </a>
    </div>

    <div class="panel" style="margin-bottom: 1rem;">
      <h3 class="panel-title">Journal publications</h3>
      <ol class="pub-list">
        {
          journalPublications.map((pub) => (
            <li>
              <div>
                <strong>{pub.title}</strong>
              </div>
              <div class="pub-meta">
                {pub.authors}. <em>{pub.venue}</em> ({pub.year})
                {pub.doi ? (
                  <span>
                    {" · "}
                    <a href={pub.doi} target="_blank" rel="noopener noreferrer">
                      DOI
                    </a>
                  </span>
                ) : null}
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="panel" style="margin-bottom: 1rem;">
      <h3 class="panel-title">Under review</h3>
      <ol class="pub-list">
        {
          underReview.map((pub) => (
            <li>
              <div>
                <strong>{pub.title}</strong>
              </div>
              <div class="pub-meta">
                {pub.authors}. {pub.venue} ({pub.year})
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="panel">
      <h3 class="panel-title">Proceedings</h3>
      <ol class="pub-list">
        {
          proceedings.map((pub) => (
            <li>
              <div>
                <strong>{pub.title}</strong>
              </div>
              <div class="pub-meta">
                {pub.authors}. <em>{pub.venue}</em> ({pub.year})
                {pub.doi ? (
                  <span>
                    {" · "}
                    <a href={pub.doi} target="_blank" rel="noopener noreferrer">
                      DOI
                    </a>
                  </span>
                ) : null}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
