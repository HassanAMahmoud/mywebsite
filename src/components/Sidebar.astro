---
import { profile } from "../data/profile";
---

<aside class="sidebar">
  <div class="sidebar-card">
    <img
      class="avatar"
      src={profile.portrait}
      alt={`Portrait of ${profile.name}`}
      width="168"
      height="168"
    />
    <div>
      <h1 class="sidebar-name">{profile.name}</h1>
      <p class="sidebar-title">{profile.title}</p>
    </div>
    <div class="sidebar-meta">
      <ul class="sidebar-links">
        <li>
          <span>
            <svg class="icon-location" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7zm0 9.5c-1.4 0-2.5-1.1-2.5-2.5S10.6 6.5 12 6.5s2.5 1.1 2.5 2.5S13.4 11.5 12 11.5z"/></svg>
            {profile.location}
          </span>
        </li>
        <li>
          <span>
            <svg class="icon-institution" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3L1 9l4 2.2V21h14v-9.8L23 9 12 3zm6 16H6v-7.3l6 3.3 6-3.3V19z"/></svg>
            {profile.institution}
          </span>
        </li>
        <li>
          <a class="sidebar-email" href={`mailto:${profile.email}`}>
            <svg class="icon-email" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/></svg>
            <span>{profile.email}</span>
          </a>
        </li>
        <li>
          <a href={profile.links.linkedin} target="_blank" rel="noopener noreferrer">
            <svg class="icon-linkedin" viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 21H3V9h3.5v12zM4.8 7.4C3.6 7.4 2.7 6.4 2.7 5.3S3.6 3.2 4.8 3.2s2.1 1 2.1 2.1-1 2.1-2.1 2.1zM21 21h-3.5v-5.8c0-1.4 0-3.2-1.9-3.2s-2.2 1.5-2.2 3.1V21H10V9h3.3v1.6h.1c.5-.9 1.6-1.9 3.4-1.9 3.6 0 4.3 2.4 4.3 5.5V21z"/></svg>
            LinkedIn
          </a>
        </li>
        <li>
          <a href={profile.links.scholar} target="_blank" rel="noopener noreferrer">
            <svg class="icon-scholar" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3L1 9l11 6 9-4.9V17h2V9L12 3zM5 13.2V17c0 1.7 3.1 3 7 3s7-1.3 7-3v-3.8l-7 3.8-7-3.8z"/></svg>
            Google Scholar
          </a>
        </li>
        <li>
          <a href={profile.links.orcid} target="_blank" rel="noopener noreferrer">
            <svg class="icon-orcid" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zM8.2 16.8H6.6V8.4h1.6v8.4zm-.8-9.5c-.6 0-1-.4-1-1s.4-1 1-1 1 .4 1 1-.4 1-1 1zm9.4 5.2c0 2.3-1.6 3.5-3.9 3.5-1.3 0-2.2-.3-3-.8l.5-1.3c.6.4 1.4.7 2.3.7 1.3 0 2.1-.7 2.1-1.8v-.1c-.5.5-1.2.8-2.1.8-2 0-3.3-1.4-3.3-3.3s1.4-3.4 3.4-3.4c.9 0 1.6.3 2.1.8V8.4h1.5c0 .2.1 8.1.1 8.1h.3zm-1.6-3.4c0-1-.7-1.7-1.7-1.7s-1.8.7-1.8 1.7.8 1.7 1.8 1.7 1.7-.7 1.7-1.7z"/></svg>
            ORCID
          </a>
        </li>
        <li>
          <a href={profile.links.cv} target="_blank" rel="noopener noreferrer">
            <svg class="icon-cv" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm4 18H6V4h7v5h5v11z"/></svg>
            CV (PDF)
          </a>
        </li>
      </ul>
    </div>
  </div>
</aside>
