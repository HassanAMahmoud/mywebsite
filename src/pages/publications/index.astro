---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PubCard from "../../components/PubCard.astro";
import { profile } from "../../data/profile";
import {
  journalPublications,
  proceedings,
  patents,
  talksAndPosters,
  type Publication,
} from "../../data/publications";

function groupByYear(items: Publication[]) {
  const groups = new Map<string, Publication[]>();

  for (const item of items) {
    const year = item.year || "Other";
    const list = groups.get(year) ?? [];
    list.push(item);
    groups.set(year, list);
  }

  return [...groups.entries()].sort(([a], [b]) => Number(b) - Number(a));
}

const categories = [
  {
    id: "journals",
    count: journalPublications.length,
    label: "Journal articles",
    years: groupByYear(journalPublications),
  },
  {
    id: "proceedings",
    count: proceedings.length,
    label: "Conference proceedings",
    years: groupByYear(proceedings),
  },
  {
    id: "talks",
    count: talksAndPosters.length,
    label: "Talks and Posters",
    years: groupByYear(talksAndPosters),
  },
  {
    id: "patents",
    count: patents.length,
    label: "Patents",
    years: groupByYear(patents),
  },
];
---

<BaseLayout
  title={`Publications - ${profile.name}`}
  description="Journal papers, conference proceedings, patents, talks and posters."
>
  <div class="pub-stats" role="tablist" aria-label="Publication categories">
    {
      categories.map((category, index) => (
        <button
          class:list={["pub-stat", { "is-active": index === 0 }]}
          type="button"
          role="tab"
          id={`tab-${category.id}`}
          aria-selected={index === 0 ? "true" : "false"}
          aria-controls={`panel-${category.id}`}
          data-category={category.id}
        >
          <span class="pub-stat-count">{category.count}</span>
          <span class="pub-stat-label">{category.label}</span>
        </button>
      ))
    }
  </div>

  <p class="pub-updated">
    For the latest version, please check my
    {" "}
    <a href={profile.links.scholar} target="_blank" rel="noopener noreferrer">
      Google Scholar profile
    </a>.
  </p>

  {
    categories.map((category, index) => (
      <section
        class:list={["pub-section", { "is-active": index === 0 }]}
        id={`panel-${category.id}`}
        role="tabpanel"
        aria-labelledby={`tab-${category.id}`}
        hidden={index !== 0}
        data-panel={category.id}
      >
        <h2>
          {category.count} {category.label}
        </h2>
        {category.years.map(([year, pubs]) => (
          <div class="pub-year-group">
            <h3 class="pub-year">{year}</h3>
            {pubs.map((pub) => (
              <PubCard pub={pub} />
            ))}
          </div>
        ))}
      </section>
    ))
  }

  <script>
    const tabs = document.querySelectorAll(".pub-stat[data-category]");
    const panels = document.querySelectorAll(".pub-section[data-panel]");

    function showCategory(id) {
      tabs.forEach((tab) => {
        const active = tab.dataset.category === id;
        tab.classList.toggle("is-active", active);
        tab.setAttribute("aria-selected", active ? "true" : "false");
      });

      panels.forEach((panel) => {
        const active = panel.dataset.panel === id;
        panel.classList.toggle("is-active", active);
        panel.hidden = !active;
      });

      history.replaceState(null, "", `#${id}`);
    }

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const id = tab.dataset.category;
        if (id) showCategory(id);
      });
    });

    const hash = window.location.hash.replace("#", "");
    if (hash && document.querySelector(`[data-panel="${hash}"]`)) {
      showCategory(hash);
    }
  </script>
</BaseLayout>
