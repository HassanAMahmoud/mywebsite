---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/profile";
import { teachingOrgs } from "../data/teaching";
---

<BaseLayout
  title={`Teaching & Supervision - ${profile.name}`}
  description="Teaching and mentorship activities."
>
  <h1>Teaching & Supervision</h1>

  <div class="teaching-list">
    {
      teachingOrgs.map((org) => (
        <section class="teaching-org">
          <div class="teaching-org-logo">
            <img src={org.logo} alt={org.name} loading="lazy" />
          </div>
          <div class="teaching-org-body">
            <h2 class="teaching-org-name">{org.name}</h2>
            <ul class="teaching-org-items">
              {org.items.map((item) => (
                <li>
                  {item.lead && <strong>{item.lead}</strong>}
                  {item.lead && (item.course || item.detail) ? " — " : null}
                  {item.course && (
                    <>
                      <em>{item.course}</em>
                      {item.detail ? " " : null}
                    </>
                  )}
                  {item.detail}
                  {item.outcomes && item.outcomes.length > 0 && (
                    <>
                      <div class="teaching-outcomes-label">Outcomes:</div>
                      <ul class="teaching-outcomes">
                        {item.outcomes.map((outcome) => (
                          <li>
                            {outcome.student && (
                              <strong>{outcome.student}: </strong>
                            )}
                            {outcome.href ? (
                              <a
                                href={outcome.href}
                                target="_blank"
                                rel="noopener noreferrer"
                              >
                                {outcome.title}
                              </a>
                            ) : (
                              <span>{outcome.title}</span>
                            )}
                            <span class="teaching-outcome-meta">
                              {" "}
                              — {outcome.venue} ({outcome.year})
                            </span>
                          </li>
                        ))}
                      </ul>
                    </>
                  )}
                </li>
              ))}
            </ul>
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
