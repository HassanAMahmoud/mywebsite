---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/profile";
import { projects } from "../data/projects";
---

<BaseLayout
  title={`Projects - ${profile.name}`}
  description="Research projects in printable wireless sensing, flexible electronics, and composite mechanics."
>
  <h1>Projects</h1>
  <p>
    Selected research themes. For a longer overview, download the
    {" "}
    <a href={profile.links.researchPdf} target="_blank" rel="noopener noreferrer">
      research presentation PDF
    </a>.
    Project figures can be added later as image grids under each theme.
  </p>

  {
    projects.map((project) => (
      <article class="project">
        <h2>
          {project.link ? (
            <a href={project.link} target="_blank" rel="noopener noreferrer">
              {project.title}
            </a>
          ) : (
            project.title
          )}
        </h2>
        <p>{project.summary}</p>
        <div class="tags">
          {project.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      </article>
    ))
  }
</BaseLayout>
