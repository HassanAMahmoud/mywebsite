---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/profile";

const cvUrl = profile.links.cv;
---

<BaseLayout title={`CV - ${profile.name}`} description="Curriculum vitae (PDF).">
  <div class="pdf-embed" id="cv-embed">
    <div class="pdf-toolbar">
      <div class="pdf-toolbar-left">
        <button class="pdf-btn" type="button" id="cv-fullscreen">
          Full Screen
        </button>
        <a class="pdf-btn" href={cvUrl} target="_blank" rel="noopener noreferrer">
          Open in New Tab
        </a>
      </div>
      <a class="pdf-btn pdf-btn-download" href={cvUrl} download>
        Download
      </a>
    </div>

    <div class="pdf-frame-wrap">
      <embed
        class="pdf-frame"
        src={`${cvUrl}#toolbar=1&navpanes=1&scrollbar=1`}
        type="application/pdf"
        title={`${profile.name} CV`}
      />
      <noscript>
        <p>
          <a href={cvUrl} target="_blank" rel="noopener noreferrer">
            Open or download the CV PDF
          </a>
        </p>
      </noscript>
    </div>
  </div>

  <script>
    const embed = document.getElementById("cv-embed");
    const button = document.getElementById("cv-fullscreen");

    if (embed && button) {
      button.addEventListener("click", async () => {
        if (!document.fullscreenElement) {
          await embed.requestFullscreen();
          button.textContent = "Exit Full Screen";
        } else {
          await document.exitFullscreen();
          button.textContent = "Full Screen";
        }
      });

      document.addEventListener("fullscreenchange", () => {
        if (!document.fullscreenElement) {
          button.textContent = "Full Screen";
        }
      });
    }
  </script>
</BaseLayout>
