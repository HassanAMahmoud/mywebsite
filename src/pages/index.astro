---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/profile";
---

<BaseLayout title={`About Me - ${profile.name}`}>
  <h1>About Me</h1>
  <p>{profile.about}</p>
  <p>My research interests include:</p>
  <ul>
    {profile.interests.map((item) => <li>{item}</li>)}
  </ul>

  <h2>My Bio</h2>
  {profile.bio.split("\n\n").map((paragraph) => <p>{paragraph}</p>)}

  <h2>Education</h2>
  <ul>
    {
      profile.education.map((item) => (
        <li>
          <strong>
            {item.degree} ({item.year})
          </strong>
          , {item.school}
          <br />
          <em>{item.detail}</em>
        </li>
      ))
    }
  </ul>
</BaseLayout>
