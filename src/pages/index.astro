---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/profile";

const affiliations = [
  {
    name: "KAUST",
    href: "https://www.kaust.edu.sa/",
    logo: "/images/logos/kaust.png",
  },
  {
    name: "The British University in Egypt",
    href: "https://www.bue.edu.eg/",
    logo: "/images/logos/bue.png",
  },
  {
    name: "Cairo University",
    href: "https://cu.edu.eg/",
    logo: "/images/logos/cairo.png",
    larger: true,
  },
];
---

<BaseLayout title={profile.name} showCover={true}>
  <h1>About Me</h1>
  <p>{profile.about}</p>
  <p>My research interests include:</p>
  <ul>
    {profile.interests.map((item) => <li>{item}</li>)}
  </ul>

  <h2>My Bio</h2>
  {profile.bio.split("\n\n").map((paragraph) => <p>{paragraph}</p>)}

  <div class="logo-row">
    {
      affiliations.map((item) => (
        <a
          class:list={["logo-link", item.larger && "logo-link--larger"]}
          href={item.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={item.name}
        >
          <img src={item.logo} alt={item.name} loading="lazy" />
        </a>
      ))
    }
  </div>
</BaseLayout>

