---
import BaseLayout from "../layouts/BaseLayout.astro";
import PubCard from "../components/PubCard.astro";
import { profile } from "../data/profile";
import {
  journalPublications,
  underReview,
  proceedings,
  patents,
  talksAndPosters,
} from "../data/publications";

const sections = [
  { id: "journals", label: `${journalPublications.length} Journal papers` },
  { id: "proceedings", label: `${proceedings.length} Conference proceedings` },
  { id: "patents", label: `${patents.length} Patents` },
  { id: "talks", label: `${talksAndPosters.length} Talks and posters` },
];
---

<BaseLayout
  title={`Publications - ${profile.name}`}
  description="Journal papers, conference proceedings, patents, talks and posters."
>
  <h1>Publications</h1>
  <p>
    Jump to:
    {
      sections.map((section, i) => (
        <span>
          {i > 0 ? " · " : ""}
          <a href={`#${section.id}`}>{section.label}</a>
        </span>
      ))
    }
    {" · "}
    <a href={profile.links.scholar} target="_blank" rel="noopener noreferrer">
      Google Scholar profile
    </a>
  </p>

  <h2 id="journals">Journal papers</h2>
  {journalPublications.map((pub) => <PubCard pub={pub} />)}

  <h3>Under review</h3>
  {underReview.map((pub) => <PubCard pub={pub} />)}

  <h2 id="proceedings">Conference proceedings</h2>
  {proceedings.map((pub) => <PubCard pub={pub} />)}

  <h2 id="patents">Patents</h2>
  {patents.map((pub) => <PubCard pub={pub} />)}

  <h2 id="talks">Talks and posters</h2>
  {talksAndPosters.map((pub) => <PubCard pub={pub} />)}
</BaseLayout>
