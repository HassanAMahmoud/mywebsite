---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { profile } from "../../data/profile";
import { projects, getProjectBySlug } from "../../data/projects";
import {
  journalPublications,
  proceedings,
  underReview,
  patents,
  talksAndPosters,
  type Publication,
} from "../../data/publications";
import { formatAuthorsHtml } from "../../utils/formatAuthors";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
  }));
}

const { slug } = Astro.params;
const project = getProjectBySlug(slug!);

if (!project) {
  throw new Error(`Project not found: ${slug}`);
}

const allPubs: Publication[] = [
  ...journalPublications,
  ...proceedings,
  ...underReview,
  ...patents,
  ...talksAndPosters,
];

function normalizeDoi(value: string): string {
  return value
    .replace(/^https?:\/\/(dx\.)?doi\.org\//i, "")
    .trim()
    .toLowerCase();
}

const relatedPublications = (project.relatedDois ?? [])
  .map((ref) => {
    const key = normalizeDoi(ref);
    return allPubs.find(
      (pub) =>
        (pub.doi && normalizeDoi(pub.doi) === key) ||
        pub.title.trim().toLowerCase() === ref.trim().toLowerCase(),
    );
  })
  .filter((pub): pub is Publication => Boolean(pub));

const hasVideos = (project.videos?.length ?? 0) > 0;
const hasAwards = (project.awards?.length ?? 0) > 0;
const hasHighlights = (project.highlights?.length ?? 0) > 0;
const hasTracks = (project.tracks?.length ?? 0) > 0;
const hasCollaborators = (project.collaborators?.length ?? 0) > 0;
const hasFigures = (project.figures?.length ?? 0) > 0;
const hasResources = (project.resources?.length ?? 0) > 0;
---

<BaseLayout
  title={`${project.title} - ${profile.name}`}
  description={project.summary}
>
  <p class="project-back">
    <a href="/research">← Back to Research</a>
  </p>

  <article class="project-detail">
    <h1>{project.title}</h1>
    <div class="tags">
      {project.tags.map((tag) => <span class="tag">{tag}</span>)}
    </div>

    {
      project.image && !project.hideHero && (
        <figure
          class:list={[
            "project-figure",
            project.imageFit === "contain" && "project-figure--contain",
          ]}
        >
          <img
            src={project.image}
            alt={`Summary figure for ${project.title}`}
          />
        </figure>
      )
    }

    <section class="project-section">
      <h2>Overview</h2>
      {project.overview.map((paragraph) => <p>{paragraph}</p>)}
    </section>

    {
      hasTracks && (
        <section class="project-section">
          <h2>Projects under this theme</h2>
          <p class="project-tracks-intro">
            Complementary projects sit under this umbrella. Each has its own
            focus and materials below.
          </p>
          <ol class="project-tracks">
            {project.tracks!.map((track, index) => (
              <li class="project-track">
                <p class="project-track-label">Project {index + 1}</p>
                <h3>{track.title}</h3>
                <p>{track.summary}</p>
                {track.collaborators && track.collaborators.length > 0 && (
                  <div class="project-collaborators project-track-collaborators">
                    {track.collaborators.map((collaborator) =>
                      collaborator.href ? (
                        <a
                          class="project-collaborator"
                          href={collaborator.href}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label={collaborator.name}
                        >
                          <img
                            src={collaborator.logo}
                            alt={collaborator.name}
                            loading="lazy"
                          />
                        </a>
                      ) : (
                        <div class="project-collaborator">
                          <img
                            src={collaborator.logo}
                            alt={collaborator.name}
                            loading="lazy"
                          />
                        </div>
                      ),
                    )}
                  </div>
                )}
                {track.highlights && track.highlights.length > 0 && (
                  <ul>
                    {track.highlights.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                )}
                {track.figures && track.figures.length > 0 && (
                  <div class="project-track-figures">
                    {track.figures.map((figure) => (
                      <figure class="project-track-figure">
                        <img
                          src={figure.src}
                          alt={figure.caption ?? track.title}
                          loading="lazy"
                        />
                        {figure.caption && (
                          <figcaption>{figure.caption}</figcaption>
                        )}
                      </figure>
                    ))}
                  </div>
                )}
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      hasHighlights && (
        <section class="project-section">
          <h2>Highlights</h2>
          <ul>
            {project.highlights!.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      )
    }

    {
      hasVideos && (
        <section class="project-section">
          <h2>Videos</h2>
          <ul class="project-video-list">
            {project.videos!.map((video) => {
              const isLocalVideo = /\.(mp4|webm|ogg)$/i.test(video.url);
              return (
                <li>
                  <strong>{video.title}</strong>
                  {video.caption && <p class="meta">{video.caption}</p>}
                  {isLocalVideo ? (
                    <div class="project-video-player">
                      <video controls preload="metadata" playsinline>
                        <source
                          src={video.url}
                          type={
                            video.url.endsWith(".webm")
                              ? "video/webm"
                              : "video/mp4"
                          }
                        />
                        Your browser does not support the video tag.
                      </video>
                    </div>
                  ) : (
                    <p>
                      <a
                        href={video.url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        Watch video
                      </a>
                    </p>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      )
    }

    {
      hasResources && (
        <section class="project-section">
          <h2>Presentation</h2>
          <ul class="project-resource-list">
            {project.resources!.map((resource) => (
              <li>
                <strong>{resource.title}</strong>
                {" — "}
                <a href={resource.href} target="_blank" rel="noopener noreferrer">
                  {resource.label ?? "Download"}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      hasFigures && (
        <section class="project-section">
          <h2>Figures</h2>
          <div class="project-figures">
            {project.figures!.map((figure) => (
              <figure class="project-extra-figure">
                <img src={figure.src} alt={figure.caption ?? project.title} loading="lazy" />
                {figure.caption && (
                  <figcaption>{figure.caption}</figcaption>
                )}
              </figure>
            ))}
          </div>
        </section>
      )
    }

    {
      hasCollaborators && (
        <section class="project-section">
          <h2>Collaborator</h2>
          <div class="project-collaborators">
            {project.collaborators!.map((collaborator) =>
              collaborator.href ? (
                <a
                  class="project-collaborator"
                  href={collaborator.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <img
                    src={collaborator.logo}
                    alt={collaborator.name}
                    loading="lazy"
                  />
                </a>
              ) : (
                <div class="project-collaborator">
                  <img
                    src={collaborator.logo}
                    alt={collaborator.name}
                    loading="lazy"
                  />
                </div>
              ),
            )}
          </div>
        </section>
      )
    }

    {
      relatedPublications.length > 0 && (
        <section class="project-section">
          <h2>Related publications</h2>
          <ul class="project-pub-list">
            {relatedPublications.map((pub) => (
              <li>
                <strong>{pub.title}</strong>
                <div class="meta">
                  <span set:html={formatAuthorsHtml(pub.authors)} />
                  {" · "}
                  <em>{pub.venue}</em> ({pub.year})
                  {pub.doi && (
                    <span>
                      {" · "}
                      <a href={pub.doi} target="_blank" rel="noopener noreferrer">
                        {pub.doi.startsWith("/") ? "[PDF]" : "[link]"}
                      </a>
                    </span>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      hasAwards && (
        <section class="project-section">
          <h2>Awards</h2>
          <ul class="project-award-list">
            {project.awards!.map((award) => (
              <li class="project-award">
                <strong>{award.title}</strong>
                {award.image && (
                  <figure class="project-award-figure">
                    <img
                      src={award.image}
                      alt={award.title}
                      loading="lazy"
                    />
                  </figure>
                )}
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>
